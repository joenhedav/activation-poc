{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/contracts": [
        "./libs/contracts/src"
      ],
      "@app/contracts/*": [
        "./libs/contracts/src/*"
      ],
      "@app/kafka-toolkit": [
        "./libs/kafka-toolkit/src"
      ],
      "@app/kafka-toolkit/*": [
        "./libs/kafka-toolkit/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/activation-poc/tsconfig.app.json"
    },
    {
      "path": "./apps/activation-api/tsconfig.app.json"
    },
    {
      "path": "./apps/billing-service/tsconfig.app.json"
    },
    {
      "path": "./apps/provisioning-service/tsconfig.app.json"
    },
    {
      "path": "./apps/notification-service/tsconfig.app.json"
    },
    {
      "path": "./apps/crm-analytics-service/tsconfig.app.json"
    },
    {
      "path": "./apps/loyalty-service/tsconfig.app.json"
    }
  ]
}